<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EduNest | Smart Campus Learning Hub</title>
    <link rel="stylesheet" type="text/css" href="Content/site.css?v=real-rating-icon-1" />

    <script src="Scripts/validation.js"></script>
    <script src="Scripts/navigation.js?v=mobile-nav-1" defer></script>
    <script src="Scripts/page-motion.js?v=site-motion-1" defer></script>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
    <svg xmlns="http://www.w3.org/2000/svg" class="svg-icon-library" aria-hidden="true" focusable="false">
        <symbol id="icon-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></symbol>
        <symbol id="icon-course" viewBox="0 0 24 24"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H21v18H6.5A2.5 2.5 0 0 0 4 22V4.5Z"/><path d="M4 5h14M8 7.5h8M8 11h8"/></symbol>
        <symbol id="icon-quiz" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.7 9a2.4 2.4 0 1 1 4.2 1.6c-1 .9-1.9 1.2-1.9 2.9M12 17h.01"/></symbol>
        <symbol id="icon-review" viewBox="0 0 24 24"><path d="M4 7h15l-3-3M20 17H5l3 3M3 12h18"/></symbol>
        <symbol id="icon-study" viewBox="0 0 24 24"><path d="M3 10.5 12 5l9 5.5-9 5.5-9-5.5ZM6.5 13v5c3.5 2.5 7.5 2.5 11 0v-5M21 10.5V17"/></symbol>
        <symbol id="icon-assignment" viewBox="0 0 24 24"><path d="M8 4h8l2 2h3v15H3V6h3l2-2Z"/><path d="M8 11h8M8 15h8M8 8h8"/></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.4-3.4 2.8-5.5 6.5-5.5s6.1 2.1 6.5 5.5M16 5a3.5 3.5 0 0 1 0 6.8M17 15c2.5.6 4 2.2 4.5 5"/></symbol>
        <symbol id="icon-home" viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10h-6v-6H9v6H3V10Z"/></symbol>
        <symbol id="icon-logout" viewBox="0 0 24 24"><path d="M10 4H4v16h6M14 8l4 4-4 4M8 12h10"/></symbol>
        <symbol id="icon-path" viewBox="0 0 24 24"><circle cx="5" cy="19" r="2"/><circle cx="19" cy="5" r="2"/><path d="M7 19h3a4 4 0 0 0 4-4V9a4 4 0 0 1 4-4"/></symbol>
        <symbol id="icon-check" viewBox="0 0 24 24"><path d="m4 12 5 5L20 6"/></symbol>
        <symbol id="icon-star" viewBox="0 0 24 24"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></symbol>
    </svg>
        <div id="appFrame" runat="server" class="app-frame">
            <asp:PlaceHolder ID="phAppSidebar" runat="server" Visible="false">
                <aside class="app-sidebar">
                    <div class="sidebar-brand-row">
                        <a class="logo sidebar-brand" href="Default.aspx" aria-label="EduNest home">
                            <span class="logo-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 10.2 12 4l8 6.2v9.3a.9.9 0 0 1-.9.9h-14a.9.9 0 0 1-.9-.9v-9.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 20v-5.8a3 3 0 0 1 6 0V20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                            <span class="brand-name">Edu<span>Nest</span><small>Smart Campus Hub</small></span>
                        </a>
                        <button type="button" class="nav-toggle" data-nav-toggle="workspaceNav" aria-controls="workspaceNav" aria-expanded="false" aria-label="Open workspace navigation">
                            <span class="hamburger-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                        </button>
                    </div>

                    <div class="sidebar-user">
                        <span class="user-avatar"><asp:Literal ID="litInitials" runat="server" /></span>
                        <span class="sidebar-user-info"><asp:Label ID="lblSidebarName" runat="server" CssClass="sidebar-user-name" /><asp:Label ID="lblSidebarRole" runat="server" CssClass="sidebar-user-role" /></span>
                    </div>

                    <nav id="workspaceNav" class="sidebar-nav" aria-label="Workspace navigation">
                        <span class="nav-caption">WORKSPACE</span>
                        <asp:PlaceHolder ID="phStudent" runat="server" Visible="false">
                            <a class="sidebar-link" href="StudentDashboard.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-dashboard" /></svg>Dashboard</a>
                            <a class="sidebar-link" href="Courses.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-course" /></svg>Courses</a>
                            <a class="sidebar-link" href="MyQuizzes.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-quiz" /></svg>My Quizzes</a>
                            <a class="sidebar-link" href="PeerReview.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-review" /></svg>Peer Review</a>
                            <a class="sidebar-link" href="StudyScheduler.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-study" /></svg>Study Rooms</a>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phLecturer" runat="server" Visible="false">
                            <a class="sidebar-link" href="LecturerDashboard.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-dashboard" /></svg>Dashboard</a>
                            <a class="sidebar-link" href="ManageCourses.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-course" /></svg>My Courses</a>
                            <a class="sidebar-link" href="ManageLearningPath.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-path" /></svg>Learning Paths</a>
                            <a class="sidebar-link" href="ManageQuizzes.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-quiz" /></svg>Quizzes</a>
                            <a class="sidebar-link" href="ManageAssignments.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-assignment" /></svg>Assignments</a>
                            <a class="sidebar-link" href="ReviewSubmissions.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-check" /></svg>Review work</a>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
                            <a class="sidebar-link" href="AdminDashboard.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-dashboard" /></svg>Dashboard</a>
                            <a class="sidebar-link" href="ManageUsers.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-users" /></svg>Users</a>
                            <a class="sidebar-link" href="ManageCourses.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-course" /></svg>Courses</a>
                            <a class="sidebar-link" href="ManageLearningPath.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-path" /></svg>Learning Paths</a>
                            <a class="sidebar-link" href="ManageQuizzes.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-quiz" /></svg>Quizzes</a>
                            <a class="sidebar-link" href="ManageAssignments.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-assignment" /></svg>Assignments</a>
                            <a class="sidebar-link" href="ReviewSubmissions.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-check" /></svg>Submissions</a>
                        </asp:PlaceHolder>
                    </nav>

                    <div class="sidebar-bottom" id="workspaceNavFooter">
                        <a class="sidebar-link" href="Default.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-home" /></svg>Public home</a>
                        <a class="sidebar-link signout-link" href="Logout.aspx"><svg class="nav-icon" aria-hidden="true"><use href="#icon-logout" /></svg>Sign out</a>
                    </div>
                </aside>
            </asp:PlaceHolder>

            <div class="app-main">
                <asp:PlaceHolder ID="phPublicHeader" runat="server">
                    <header class="public-header">
                        <div class="public-header-inner">
                            <div class="public-brand-row">
                                <a class="logo" href="Default.aspx" aria-label="EduNest home">
                                    <span class="logo-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 10.2 12 4l8 6.2v9.3a.9.9 0 0 1-.9.9h-14a.9.9 0 0 1-.9-.9v-9.3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 20v-5.8a3 3 0 0 1 6 0V20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                                    <span class="brand-name">Edu<span>Nest</span></span>
                                </a>
                                <button type="button" class="nav-toggle" data-nav-toggle="publicNav" aria-controls="publicNav" aria-expanded="false" aria-label="Open main navigation">
                                    <span class="hamburger-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                                </button>
                            </div>
                            <nav id="publicNav" class="public-nav" aria-label="Main navigation">
                                <a href="Default.aspx#features">Features</a>
                                <a href="Default.aspx#how-it-works">How it works</a>
                                <a href="Courses.aspx">Courses</a>
                                <a class="public-login" href="Login.aspx">Sign in</a>
                                <a class="public-cta" href="Register.aspx">Get started</a>
                            </nav>
                        </div>
                    </header>
                </asp:PlaceHolder>

                <asp:PlaceHolder ID="phAppTopbar" runat="server" Visible="false">
                    <header class="app-topbar">
                        <div><span class="topbar-kicker">YOUR WORKSPACE</span><strong>Welcome back, <asp:Label ID="lblTopbarName" runat="server" /></strong></div>
                        <div class="topbar-actions"><span class="workspace-badge"><asp:Label ID="lblTopbarRole" runat="server" /></span><a class="topbar-logout" href="Logout.aspx">Sign out &#8599;</a></div>
                    </header>
                </asp:PlaceHolder>

                <main class="site-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>

                <asp:PlaceHolder ID="phPublicFooter" runat="server">
                    <footer class="site-footer"><p>&copy; 2026 EduNest &middot; A smarter space for learning</p></footer>
                </asp:PlaceHolder>
            </div>
        </div>
    </form>
</body>
</html>
